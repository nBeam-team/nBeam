# Copy this file to .env.local and fill in your own keys.
# .env.local is gitignored.

# ---- Google Maps Platform ----
# Client-side. Must have BOTH Maps JavaScript API and Places API enabled
# (the Places Autocomplete widget loads from the same script as Maps JS).
VITE_GOOGLE_MAPS_KEY=

# Optional. Reserved for future direct Places REST calls. Not currently used.
VITE_GOOGLE_PLACES_KEY=

# Used by the Solar API REST clients (buildingInsights:findClosest,
# dataLayers:get, geoTiff:get). Falls back to VITE_GOOGLE_MAPS_KEY when unset.
VITE_GOOGLE_SOLAR_KEY=

# ---- Tavily (Backend) ----
# Required for the /api/tavily/search serverless function.
TAVILY_API_KEY=

# ---- Gemini (Backend) ----
# Required for /api/gemini/extract and /api/gemini/chat serverless functions.
GEMINI_API_KEY=
